# Copia este archivo a .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio.

# --- Correo saliente (Gmail con App Password, NO la contraseña normal) ---
# Regenera la App Password en https://myaccount.google.com/apppasswords
EMAIL_USER=you@example.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# --- Qwen (DashScope) — opcional; sin clave se usa plantilla fallback ---
QWEN_API_KEY=

# --- SEO / canonical URL del sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe checkout link (CTA de monitoreo semanal) ---
NEXT_PUBLIC_STRIPE_LINK=
